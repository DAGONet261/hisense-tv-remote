# Copier ce fichier en .env et renseigner les valeurs reelles.
# Aucun secret ne doit etre ecrit ailleurs que dans .env (jamais dans
# CLAUDE.md, SPEC.md, contexte/, ou tout fichier suivi par Git).

# Adresse IP de la TV (optionnel si la decouverte automatique de tv.exe suffit)
HISENSE_TV_IP=

# Alias de la TV configure dans pyvidaa
HISENSE_TV_ALIAS=salon

# Mot de passe du conteneur PKCS12 du certificat client VIDAA (pour reconvertir le .p12 en PEM)
VIDAA_P12_PASSWORD=
