<Project>
  <!--
    Identité de l'application (projet WPF seulement ; le projet temporaire « _wpftmp » de la
    compilation XAML reçoit les mêmes réglages). Version : voir Directory.Build.targets et
    contexte/publication.md.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HisenseTvRemote' Or $(MSBuildProjectName.EndsWith('_wpftmp'))">
    <HtrRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</HtrRoot>
    <HtrVersionFile>$(HtrRoot)version.txt</HtrVersionFile>
    <HtrDistDir>$(HtrRoot)dist\</HtrDistDir>

    <Product>VIDAA - Hisense</Product>
    <AssemblyTitle>VIDAA - Hisense</AssemblyTitle>
    <Description>Télécommande pour téléviseurs Hisense VIDAA</Description>
    <Company>Tiana Riantsoa RAHARISON</Company>
    <Copyright>© 2026 Tiana Riantsoa RAHARISON</Copyright>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <ApplicationIcon>Resources\VidaaHisense.ico</ApplicationIcon>

    <!-- Publication autonome Windows x64 (aucun .NET à installer sur le poste cible). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Licence MIT du projet, livrée à côté de l'exe (avec THIRD-PARTY-NOTICES.md). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'HisenseTvRemote'">
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    FFmpeg (LGPL) : conversion des vidéos TS, AVI… avant le partage vers la TV. Récupéré par
    build/Get-FFmpeg.ps1 dans third_party/ffmpeg (non versionné), copié dans ffmpeg/ à côté de l'exe.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'HisenseTvRemote' And Exists('$(MSBuildThisFileDirectory)..\third_party\ffmpeg\ffmpeg.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\third_party\ffmpeg\*" Link="ffmpeg\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
