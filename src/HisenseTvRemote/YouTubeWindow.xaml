<Window x:Class="HisenseTvRemote.YouTubeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envoyer un lien YouTube" Height="265" Width="620" MinWidth="460" MinHeight="230"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ResizeMode="CanResizeWithGrip"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Envoyer un lien YouTube à la TV" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                       Text="Collez le lien d'une vidéo (youtube.com/watch?v=…, youtu.be/…, Shorts…) : YouTube s'ouvre sur la TV et la lit, comme le bouton « caster » du téléphone."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="90" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Entrée : lire sur la TV · Échap : fermer"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="QueueButton" AutomationProperties.Name="Ajouter à la file" Style="{StaticResource SmallButton}" Click="OnQueue"
                    ToolTip="Ajouter la vidéo à la suite de ce que YouTube lit sur la TV">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,6,0"/>
                    <TextBlock Text="Ajouter à la file"/>
                </StackPanel>
            </Button>
            <Button x:Name="PlayButton" AutomationProperties.Name="Lire sur la TV" Style="{StaticResource AccentButton}" Click="OnPlay"
                    Margin="8,0,0,0" Padding="16,0" Height="36" IsDefault="True" ToolTip="Ouvrir YouTube sur la TV et lire la vidéo (Entrée)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,6,0"/>
                    <TextBlock Text="Lire sur la TV"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBox x:Name="Link" AutomationProperties.Name="Lien YouTube" VerticalContentAlignment="Center" Height="38"
                 TextChanged="OnLinkChanged" ToolTip="Lien d'une vidéo YouTube"/>
    </DockPanel>
</Window>
