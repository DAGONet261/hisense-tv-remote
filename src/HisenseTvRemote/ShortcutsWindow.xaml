<Window x:Class="HisenseTvRemote.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourcis clavier" Height="640" Width="560" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource DarkWindow}">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Raccourcis clavier" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="Actifs quand la fenêtre de la télécommande est au premier plan. Lettres et chiffres seuls : réservés à la saisie de texte et au pavé numérique (à venir)."/>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Fermer" IsCancel="True" IsDefault="True"
                Click="OnClose" Margin="0,12,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Groups"/>
        </ScrollViewer>
    </DockPanel>
</Window>
