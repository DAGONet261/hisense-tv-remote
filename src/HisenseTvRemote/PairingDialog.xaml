<Window x:Class="HisenseTvRemote.PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appairage de la TV" Height="400" Width="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource DarkWindow}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Appairage par code PIN" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="Hint" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"
                   Text="Connexion à la TV… Le champ PIN s'activera dès que le code sera affiché sur l'écran de la TV."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="Annuler" Click="OnClose"/>
            <Button x:Name="SendBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Valider le PIN"
                    IsEnabled="False" IsDefault="True" Click="OnSend"/>
            <TextBox x:Name="PinBox" FontSize="20" MaxLength="12" IsEnabled="False" ToolTip="Code à 4 chiffres affiché sur la TV"/>
        </DockPanel>
        <TextBox x:Name="Console" Style="{StaticResource ConsoleBox}"/>
    </DockPanel>
</Window>
